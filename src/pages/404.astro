---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found" description="This page doesn't exist.">
  <section class="pt-32 pb-20 md:pt-40">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="display-xl">Flag on<br />the play</h1>
      <p class="text-xl text-muted mt-8 max-w-prose border-t-4 border-rule pt-6">
        This page doesn't exist (404). After further review, the ruling on the
        field stands: head back home.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Go home</a>
        <a href="/case-studies/" class="btn btn-ghost">See the case studies</a>
      </div>
    </div>
  </section>
</Base>
