---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import talkPhoto from "../assets/images/speaking/case-district-1-2-2023.jpg";
import { speaking } from "../data/resume";

const showGrowthNote = speaking.length < 2;
---

<Base
  title="Speaking"
  description="Conference talks and presentations by Bryan Barnes."
>
  <section class="pt-32 pb-20 md:pt-40">
    <div class="max-w-4xl mx-auto px-6">
      <h1 class="text-6xl md:text-8xl mb-4">
        Speaking
      </h1>
      <p class="text-muted text-lg mb-16 max-w-prose">
        Conference talks on accessibility, digital strategy, and marketing technology.
      </p>

      <figure class="panel p-3 mb-10">
        <Image src={talkPhoto} alt="Bryan Barnes at a podium beside a projected slide reading Accessible Design is Better Design (for everyone), CASE District I and II Annual Conference." class="w-full h-auto rounded-sm" />
        <figcaption class="text-muted text-sm mt-3 px-1">
          Presenting "Accessible Design is Better Design (for everyone)" at the CASE District I &amp; II Annual Conference, March 2023.
        </figcaption>
      </figure>

      <div class="space-y-6">
        {
          speaking.map((talk) => (
            <article class="panel p-6 md:p-8">
              <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                <div>
                  <h2 class="text-3xl md:text-4xl">{talk.title}</h2>
                  <p class="text-muted mt-1">{talk.event}</p>
                </div>
                <p class="text-faint text-sm whitespace-nowrap">
                  {talk.location ? `${talk.location}, ` : ""}{talk.date}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      {showGrowthNote && <p class="text-faint text-sm mt-8">
            More talks coming. This section will grow.
          </p>}
    </div>
  </section>
</Base>
