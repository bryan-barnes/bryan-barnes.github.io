---
const teams = [
  { id: "auto", label: "In season" },
  { id: "ravens", label: "Ravens" },
  { id: "orioles", label: "Orioles" },
  { id: "terps", label: "Terps" },
  { id: "off", label: "Off-season" },
];

const lights = [
  { id: "auto", label: "Auto" },
  { id: "day", label: "Day game" },
  { id: "night", label: "Night game" },
];
---

<div class="theme-switcher no-print">
  <div id="theme-panel" class="theme-panel" hidden>
    <fieldset>
      <legend>Team colors</legend>
      <div class="options">
        {
          teams.map((t) => (
            <button type="button" data-team-option={t.id} aria-pressed="false">
              {t.label}
            </button>
          ))
        }
      </div>
    </fieldset>
    <fieldset>
      <legend>Lights</legend>
      <div class="options">
        {
          lights.map((l) => (
            <button type="button" data-lights-option={l.id} aria-pressed="false">
              {l.label}
            </button>
          ))
        }
      </div>
    </fieldset>
    <p class="note">
      In season follows the calendar: Ravens in the fall, Terps in the
      winter, Orioles in the spring and summer.
    </p>
  </div>

  <button
    id="theme-toggle"
    type="button"
    class="scorebug"
    aria-expanded="false"
    aria-controls="theme-panel"
  >
    <span class="sr-only">Change site colors. Current: </span>
    <span class="bug-team" data-bug-team>BAL</span>
    <span class="bug-mode" data-bug-mode>Day</span>
  </button>
</div>

<style>
  .theme-switcher {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    font-family: theme("fontFamily.sans");
  }

  .scorebug {
    display: flex;
    align-items: stretch;
    border: 2px solid rgb(var(--ink));
    box-shadow: 3px 3px 0 rgb(var(--ink));
    cursor: pointer;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .scorebug:hover,
  .scorebug[aria-expanded="true"] {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 rgb(var(--ink));
  }

  .bug-team,
  .bug-mode {
    font-family: theme("fontFamily.display");
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.95rem;
    line-height: 1;
    padding: 0.5rem 0.65rem 0.45rem;
  }

  .bug-team {
    background: rgb(var(--accent));
    color: rgb(var(--on-accent));
    min-width: 3.25rem;
    text-align: center;
  }

  .bug-mode {
    background: rgb(var(--paper));
    color: rgb(var(--ink));
  }

  .theme-panel {
    width: min(20rem, calc(100vw - 2rem));
    background: rgb(var(--paper));
    color: rgb(var(--ink));
    border: 2px solid rgb(var(--ink));
    box-shadow: 5px 5px 0 rgb(var(--ink));
    padding: 1rem;
  }

  .theme-panel[hidden] {
    display: none;
  }

  fieldset + fieldset {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid rgb(var(--ink) / 0.2);
  }

  legend {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--muted));
    margin-bottom: 0.5rem;
  }

  .options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .options button {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.4rem 0.6rem;
    border: 1.5px solid rgb(var(--ink) / 0.35);
    color: rgb(var(--ink));
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .options button:hover {
    border-color: rgb(var(--ink));
  }

  .options button[aria-pressed="true"] {
    background: rgb(var(--ink));
    border-color: rgb(var(--ink));
    color: rgb(var(--paper));
  }

  .note {
    margin-top: 0.9rem;
    font-size: 0.75rem;
    line-height: 1.45;
    color: rgb(var(--muted));
  }

  @media (prefers-reduced-motion: reduce) {
    .scorebug {
      transition: none;
    }
    .scorebug:hover,
    .scorebug[aria-expanded="true"] {
      transform: none;
    }
  }
</style>

<script>
  type SiteTheme = {
    apply: () => void;
    read: (key: string) => string;
  };

  const site = (window as unknown as { __siteTheme: SiteTheme }).__siteTheme;
  const root = document.documentElement;
  const toggle = document.getElementById("theme-toggle") as HTMLButtonElement;
  const panel = document.getElementById("theme-panel") as HTMLElement;
  const switcher = document.querySelector(".theme-switcher") as HTMLElement;
  const bugTeam = document.querySelector("[data-bug-team]") as HTMLElement;
  const bugMode = document.querySelector("[data-bug-mode]") as HTMLElement;

  const abbreviations: Record<string, string> = {
    ravens: "Ravens",
    orioles: "O's",
    terps: "Terps",
    off: "Off",
  };

  function save(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* storage blocked: theme still applies for this page view */
    }
  }

  function sync() {
    const team = site.read("theme");
    const lights = site.read("lights");
    document.querySelectorAll<HTMLElement>("[data-team-option]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.teamOption === team));
    });
    document.querySelectorAll<HTMLElement>("[data-lights-option]").forEach((b) => {
      b.setAttribute("aria-pressed", String(b.dataset.lightsOption === lights));
    });
    bugTeam.textContent = abbreviations[root.dataset.team || "orioles"] || "BB";
    bugMode.textContent = root.dataset.mode === "night" ? "Night" : "Day";
  }

  function setOpen(open: boolean) {
    panel.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  }

  toggle.addEventListener("click", (e) => {
    e.stopPropagation();
    setOpen(panel.hidden);
  });

  document.querySelectorAll<HTMLElement>("[data-team-option]").forEach((b) => {
    b.addEventListener("click", () => {
      save("theme", b.dataset.teamOption || "auto");
      site.apply();
      sync();
    });
  });

  document.querySelectorAll<HTMLElement>("[data-lights-option]").forEach((b) => {
    b.addEventListener("click", () => {
      save("lights", b.dataset.lightsOption || "auto");
      site.apply();
      sync();
    });
  });

  document.addEventListener("click", (e) => {
    if (!switcher.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !panel.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });

  window
    .matchMedia("(prefers-color-scheme: dark)")
    .addEventListener("change", () => sync());

  sync();
</script>
